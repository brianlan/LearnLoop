## Shared app runtime settings.
## Docker Compose reuses the MongoDB and S3/RustFS values below for portable local services.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017/learnloop?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=learnloop

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=learnloop-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

INGESTION_VLM_ENDPOINT=https://example-ingestion-vlm-provider.invalid/api
INGESTION_VLM_MODEL=replace-me
INGESTION_VLM_API_KEY=replace-me
INGESTION_VLM_TIMEOUT_SECONDS=120
GRADING_VLM_ENDPOINT=https://example-grading-vlm-provider.invalid/api
GRADING_VLM_MODEL=replace-me
GRADING_VLM_API_KEY=replace-me
GRADING_VLM_TIMEOUT_SECONDS=60

## Problem variant generation profiles (issue #612)
## Generator, validator (and optional second validator) use task-specific models;
## answer-equivalence comparison reuses the HELPER_VLM_* profile.
VARIANT_GENERATOR_VLM_ENDPOINT=https://example-variant-generator-vlm-provider.invalid/api
VARIANT_GENERATOR_VLM_MODEL=replace-me
VARIANT_GENERATOR_VLM_API_KEY=replace-me
VARIANT_GENERATOR_VLM_TIMEOUT_SECONDS=120
VARIANT_GENERATOR_VLM_PROVIDER=openai
VARIANT_GENERATOR_VLM_API_MODE=chat
VARIANT_VALIDATOR_VLM_ENDPOINT=https://example-variant-validator-vlm-provider.invalid/api
VARIANT_VALIDATOR_VLM_MODEL=replace-me
VARIANT_VALIDATOR_VLM_API_KEY=replace-me
VARIANT_VALIDATOR_VLM_TIMEOUT_SECONDS=120
VARIANT_VALIDATOR_VLM_PROVIDER=openai
VARIANT_VALIDATOR_VLM_API_MODE=chat
VARIANT_VALIDATOR2_VLM_ENDPOINT=https://example-variant-validator2-vlm-provider.invalid/api
VARIANT_VALIDATOR2_VLM_MODEL=replace-me
VARIANT_VALIDATOR2_VLM_API_KEY=replace-me
VARIANT_VALIDATOR2_VLM_TIMEOUT_SECONDS=120
VARIANT_VALIDATOR2_VLM_PROVIDER=openai
VARIANT_VALIDATOR2_VLM_API_MODE=chat
HELPER_VLM_ENDPOINT=https://example-helper-vlm-provider.invalid/api
HELPER_VLM_MODEL=replace-me
HELPER_VLM_API_KEY=replace-me
HELPER_VLM_TIMEOUT_SECONDS=60
HELPER_VLM_PROVIDER=openai
HELPER_VLM_API_MODE=chat
PREVIEW_EXTRACTING_WINDOW_SECONDS=150

## AI tutoring VLM configuration
## Solution generation and coaching use separate provider configuration.
## Endpoints must be OpenAI-compatible base URLs (backend posts to /chat/completions relative to base).
SOLUTION_VLM_ENDPOINT=https://example-solution-provider.invalid/api
SOLUTION_VLM_MODEL=replace-me
SOLUTION_VLM_API_KEY=replace-me
SOLUTION_VLM_TIMEOUT_SECONDS=120

COACHING_VLM_ENDPOINT=https://example-coaching-provider.invalid/api
COACHING_VLM_MODEL=replace-me
COACHING_VLM_API_KEY=replace-me
COACHING_VLM_TIMEOUT_SECONDS=60

## Solution worker tuning
SOLUTION_WORKER_POLL_INTERVAL_SECONDS=5
SOLUTION_TASK_TIMEOUT_MINUTES=10
SOLUTION_MAX_RETRIES=3

## Variation worker (per-item variant generation/validation in bulk ingestion)
## The worker requires the generator, validator and helper profiles above;
## the second validator is optional (unconfigured = single-validator mode).
VARIATION_WORKER_ENABLED=true
VARIATION_WORKER_POLL_INTERVAL_SECONDS=5
VARIATION_LEASE_TIMEOUT_SECONDS=300
VARIATION_WORKER_CONCURRENCY=2

SESSION_COOKIE_NAME=ll_session
SESSION_SECURE=false
SESSION_SAMESITE=lax

## Problem selection configuration (shared by practice and exam)
PROBLEM_SELECTION_COOLDOWN_DAYS=7
PROBLEM_SELECTION_LAST_WRONG_WEIGHT=1.0
PROBLEM_SELECTION_FAILURE_RATE_WEIGHT=1.0
PROBLEM_SELECTION_RECENCY_WEIGHT=1.0
PROBLEM_SELECTION_MIN_AGE_DAYS=3
